{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@stockly/domain": ["../../packages/domain/src"],
      "@stockly/domain/*": ["../../packages/domain/src/*"],
      "@stockly/validation": ["../../packages/validation/src"],
      "@stockly/validation/*": ["../../packages/validation/src/*"],
      "@stockly/permissions": ["../../packages/permissions/src"],
      "@stockly/permissions/*": ["../../packages/permissions/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
